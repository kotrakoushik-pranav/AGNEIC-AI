# Base URL for all API calls from the browser (dashboard → backend).
# Keep this as localhost if both browser and backend run on the same machine.
VITE_API_BASE_URL=http://localhost:8000

# Optional override for the LAN IP used in QR codes so phones can reach the
# backend over Wi-Fi. When left empty the app auto-detects the LAN IP at
# runtime by calling GET /api/network-info on the backend.
# Set this only if auto-detection returns the wrong IP (e.g. inside a VM or
# with multiple network interfaces).
# Example: VITE_API_LAN_URL=http://192.168.1.42:8000
VITE_API_LAN_URL=
