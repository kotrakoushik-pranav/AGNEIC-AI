# ── Backend API ──────────────────────────────────────────────
# Base URL for all API calls from the browser
VITE_API_BASE_URL=http://localhost:8000

# Optional: override LAN IP for QR code URLs (leave empty for auto-detect)
VITE_API_LAN_URL=

# ── Supabase (required for Auth + Realtime + persistent storage) ──
# Get these from: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key_here
