# ── Database ─────────────────────────────────────────────────
# SQLite for local dev:  sqlite:///./aegis_ai.db
# PostgreSQL for prod:   postgresql://user:pass@host:5432/dbname
# Supabase PostgreSQL:   postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres
DATABASE_URL=sqlite:///./aegis_ai.db

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── App environment ───────────────────────────────────────────
ENVIRONMENT=development

# Set DEMO_MODE=true when running seed.py to insert simulated incidents for UI demo.
DEMO_MODE=false

# ── Supabase (backend service-role key — NEVER expose to frontend) ──
# Get from: Supabase Dashboard → Project Settings → API → service_role
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_ANON_KEY=your_anon_public_key_here

# ── Network / Mobile Camera ───────────────────────────────────
SERVER_PORT=8443
TLS_ENABLED=true
LAN_IP_OVERRIDE=
SESSION_EXPIRY_SECONDS=600

# ── Face Recognition ─────────────────────────────────────────
FACE_RECOGNITION_THRESHOLD=0.363
FACE_DETECTION_CONFIDENCE=0.85
FACE_CONFIRMATION_FRAMES=3
FACE_UNKNOWN_COOLDOWN=15
FACE_RECOGNIZED_COOLDOWN=30
FACE_PROCESS_EVERY_N=3

# ── Camera Adapters ───────────────────────────────────────────
CAMERA_TIMEOUT=10
RECONNECT_INTERVAL=5
MAX_RECONNECT_ATTEMPTS=10
CAMERA_PROCESS_EVERY_N=3
FRAME_STALL_TIMEOUT=10.0
